local function t(key) if L[Lang] and L[Lang][key] then return L[Lang][key] end return L["en"][key] or key end
local function deepCopy(orig) local copy = {} for k, v in pairs(orig) do if type(v) == "table" then copy[k] = deepCopy(v) else copy[k] = v end end return copy end
local function mergeConfig(target, source) for k, v in pairs(source) do if type(v) == "table" and type(target[k]) == "table" then mergeConfig(target[k], v) elseif v ~= nil then target[k] = v end end end

local function serialize(tbl)
    local function serializeTable(t)
        local result = {}
        for k, v in pairs(t) do
            if typeof(v) == "Color3" then result[k] = {__type = "Color3", R = v.R, G = v.G, B = v.B}
            elseif typeof(v) == "EnumItem" then result[k] = {__type = "EnumItem", Name = v.Name, EnumType = v.EnumType.Name}
            elseif type(v) == "table" then result[k] = serializeTable(v)
            else result[k] = v end
        end
        return result
    end
    return serializeTable(tbl)
end

local function deserialize(tbl)
    if type(tbl) ~= "table" then return tbl end
    if tbl.__type == "Color3" then return Color3.new(tbl.R, tbl.G, tbl.B)
    elseif tbl.__type == "EnumItem" then
        local eType = tbl.EnumType or "KeyCode"
        local eName = tbl.Name
        if type(eName) == "string" then
            local success, enumVal = pcall(function()
                return Enum[eType][eName]
            end)
            if success and enumVal then return enumVal end
        end
        return nil
    end
    local result = {}
    for k, v in pairs(tbl) do result[k] = deserialize(v) end
    return result
end

