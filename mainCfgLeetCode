    if not selectedTargetName then return end local target = Players:FindFirstChild(selectedTargetName) if not target or not target.Character then return end
    local targetHrp = target.Character:FindFirstChild("HumanoidRootPart") local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not targetHrp or not myHrp then return end
    flingVisualEffect()
    local start = tick() local conn
    conn = RunService.Heartbeat:Connect(function()
        if not targetHrp or not targetHrp.Parent or not myHrp or not myHrp.Parent or tick() - start > 1.5 then if conn then conn:Disconnect() end return end
