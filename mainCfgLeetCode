local function hasLOS(targetPos, targetChar)
    local params = RaycastParams.new() 
    params.FilterType = Enum.RaycastFilterType.Exclude 
    params.IgnoreWater = true 
    params.RespectCanCollide = false 
    local ign = {} 
    if LP.Character then table.insert(ign, LP.Character) end 
    if targetChar then table.insert(ign, targetChar) end 
    params.FilterDescendantsInstances = ign
    local origin = Camera.CFrame.Position 
    if LP.Character and LP.Character:FindFirstChild("Head") then origin = LP.Character.Head.Position end
    local ray = workspace:Raycast(origin, targetPos - origin, params)
    return ray == nil
end

function getClosest(cf, preferredTarget)
    local closest, minScreenDist = nil, math.huge local center = Camera.ViewportSize / 2
    if preferredTarget and preferredTarget.Character and preferredTarget.Character:FindFirstChild("Head") then
        local hum = preferredTarget.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local sp, onscreen = Camera:WorldToViewportPoint(preferredTarget.Character.Head.Position)
            if onscreen and (Vector2.new(sp.X, sp.Y) - center).Magnitude <= Config.Aim.FOVRadius then
                local dist = (preferredTarget.Character.Head.Position - cf.Position).Magnitude
                if dist <= Config.Aim.AimRadius then
                    local skip = false
                    if Config.Aim.FriendCheck and friendCache[preferredTarget] then skip = true end
                    if Config.Aim.IgnoreTeam and LP.Team ~= nil and preferredTarget.Team ~= nil and preferredTarget.Team == LP.Team then skip = true end
                    if not Config.Aim.ShootThroughWalls and not hasLOS(preferredTarget.Character.Head.Position, preferredTarget.Character) then skip = true end
                    if not skip then return preferredTarget end
                end
            end
        end
    end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and p.UserId ~= LP.UserId and p.Name ~= LP.Name and p.Character ~= LP.Character and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum=p.Character:FindFirstChildOfClass("Humanoid") local dead=(hum==nil or hum.Health<=0) local skip=false
            if dead and Config.Aim.IgnoreDead then skip=true end
            if not skip and Config.Aim.FriendCheck and friendCache[p] then skip = true end
            if not skip and Config.Aim.IgnoreTeam and LP.Team ~= nil and p.Team ~= nil and p.Team == LP.Team then skip = true end
            if not skip then
                local sp, onscreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                if onscreen then
                    local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude local realDist = (p.Character.Head.Position - cf.Position).Magnitude
                    if screenDist <= Config.Aim.FOVRadius and realDist <= Config.Aim.AimRadius then
                        if not Config.Aim.ShootThroughWalls then if not hasLOS(p.Character.Head.Position, p.Character) then skip=true end end
                        if not skip and screenDist < minScreenDist then minScreenDist = screenDist closest = p end
                    end
                end
            end
        end
    end
    return closest
end

