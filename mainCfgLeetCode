local function setupKillSound(plr)
    local function onChar(char)
        local hum = char:WaitForChild("Humanoid", 10) if not hum then return end
        hum.Died:Connect(function()
            if not scriptEnabled then return end
            task.wait(0.05)
            if hum:GetAttribute("KilledByMe") then return end

            local isMe, isHeadshot = false, false

            local tags = {"creator","Creator","Killer","killer","LastAttacker"}
            for _, tagName in ipairs(tags) do
                local tag = char:FindFirstChild(tagName) or hum:FindFirstChild(tagName)
                if tag then
                    local val = tag.Value
                    if typeof(val) == "Instance" and val == LP then isMe = true
                    elseif tostring(val) == tostring(LP.UserId) or tostring(val) == LP.Name then isMe = true end
                end
            end

            if lastAimedPlayer == plr and (tick() - lastAimedTime < 5.0) then
                isMe = true
            end

            local tHead = char:FindFirstChild("Head")
            local tRoot = char:FindFirstChild("HumanoidRootPart")
            
            if not isMe and tRoot then
                for _, shot in ipairs(recentShots) do
                    if tick() - shot.time < 2.0 then
                        local dist = (tRoot.Position - shot.origin).Magnitude
                        if dist < 1000 then
                            local dirToTarget = (tRoot.Position - shot.origin).Unit
                            if dirToTarget:Dot(shot.dir) > 0.92 then -- Щедрый детект (примерно 23 градуса)
                                isMe = true
                                if tHead then
                                    local dirToHead = (tHead.Position - shot.origin).Unit
                                    if dirToHead:Dot(shot.dir) > 0.97 then
                                        isHeadshot = true
                                    end
                                end
                                break
                            end
                        end
                    end
                end
            end

            if not isMe and tHead then
                local sp, onscreen = Camera:WorldToViewportPoint(tHead.Position)
                if onscreen then
                    local center = Camera.ViewportSize / 2
                    if (Vector2.new(sp.X, sp.Y) - center).Magnitude < 200 then isMe = true end
                end
            end

            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if myRoot and tRoot and (myRoot.Position - tRoot.Position).Magnitude > 1000 then isMe = false end

            if isMe then
                hum:SetAttribute("KilledByMe", true)
                local msg = isHeadshot and t("kill_msg_head") or t("kill_msg_you")
                addKillNotification(string.format(msg, plr.Name))
                playKillSound()
            end
        end)
    end
    if plr.Character then onChar(plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end

