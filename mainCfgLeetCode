    createButton(setCont,t("load"),function() 
        local name=(selectedConfig~="") and selectedConfig or nameBox.Text 
        if name=="" then notify("Выберите конфиг!") return end 
        local f=CFG_DIR.."/"..name..".cfg" 
        if readfile and isfile and isfile(f) then 
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(f)) end) 
            if ok and type(data) == "table" then 
                local decoded = deserialize(data) 
                Config = deepCopy(DefaultConfig) 
                mergeConfig(Config, decoded) 
                sanitizeConfig() 
                
                if Config.Settings and Config.Settings.Theme then 
                    if Config.Settings.Theme == "Custom" then Accent = customAccent 
                    else for _, theme in ipairs(ThemeList) do if theme.Name == Config.Settings.Theme then Accent = theme.Color break end end end 
                    if writefile then pcall(function() writefile(THEME_FILE, Config.Settings.Theme) end) end 
                end 
                TextCol = getContrastColor(Accent) 
                nameBox.Text=name 
                
                if screenGui then screenGui:Destroy() end 
                if hudGui then hudGui:Destroy() end
                if pickerGui then pickerGui:Destroy() end
                if cfgPopupGui then cfgPopupGui:Destroy() end
                if langPopupGui then langPopupGui:Destroy() end
                if avatarPopupGui then avatarPopupGui:Destroy() end
                
                task.wait(0.1) 
                
                task.spawn(function() 
                    local success, err = pcall(function() BuildUI(false) end)
                    if not success then notify("Ошибка UI: "..tostring(err)) end
                end) 
                notify("Конфиг загружен!")
            end 
        end 
    end,4)
    
