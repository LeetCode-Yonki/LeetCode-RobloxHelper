local function sanitizeConfig()
    if type(Config) ~= "table" then Config = deepCopy(DefaultConfig) end
    for k, v in pairs(DefaultConfig) do
        if type(v) == "table" then
            if type(Config[k]) ~= "table" then Config[k] = deepCopy(v) end
            for subK, subV in pairs(v) do
                if type(subV) == "table" then
                    if type(Config[k][subK]) ~= "table" then Config[k][subK] = deepCopy(subV) end
                    for subSubK, subSubV in pairs(subV) do
                        if Config[k][subK][subSubK] == nil or type(Config[k][subK][subSubK]) ~= type(subSubV) then
                            Config[k][subK][subSubK] = subSubV
                        end
                    end
                else
                    if Config[k][subK] == nil or type(Config[k][subK]) ~= type(subV) then
                        Config[k][subK] = subV
                    end
                end
            end
        elseif Config[k] == nil or type(Config[k]) ~= type(v) then
            Config[k] = v
        end
    end
    
    if type(Config.Binds) ~= "table" then Config.Binds = deepCopy(DefaultConfig.Binds) end
    local function isKbBind(x)
        return typeof(x) == "EnumItem" and x.EnumType == Enum.KeyCode
    end
    for k, v in pairs(DefaultConfig.Binds) do
        if not isKbBind(Config.Binds[k]) then
            Config.Binds[k] = v
        end
    end
    if not isKbBind(Config.Aim.Bind) then
        Config.Aim.Bind = DefaultConfig.Aim.Bind
    end
end

