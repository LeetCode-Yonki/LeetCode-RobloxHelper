    table.insert(uiConnections,UIS.InputBegan:Connect(function(input,gp)
        if gp then return end
        if listeningFor then
            if input.KeyCode == Config.Binds.Menu or input.KeyCode == Enum.KeyCode.Escape then 
                listeningFor = nil 
                for _,e in pairs(bindButtons) do refreshBind(e) end 
                return 
            end
            
            -- Биндим только на клавиатуру
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
                listeningFor.set(input.KeyCode)
                for _,e in pairs(bindButtons) do 
                    if e.ref == listeningFor then refreshBind(e) end 
                end
                listeningFor = nil
                return
            end

            -- Мышь не разрешена
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2
            or input.UserInputType == Enum.UserInputType.MouseButton3 then
                listeningFor = nil
                for _,e in pairs(bindButtons) do refreshBind(e) end
                local n = Instance.new("TextLabel")
                n.Size = UDim2.new(0, 260, 0, 34)
                n.Position = UDim2.new(0.5, -130, 0.85, 0)
                n.BackgroundColor3 = Color3.fromRGB(20,20,20)
                n.TextColor3 = Color3.fromRGB(255, 80, 80)
                n.Font = Enum.Font.GothamBold
                n.TextSize = 14
                n.Text = "Только клавиатура!"
                n.ZIndex = 999
                n.Parent = screenGui
                Instance.new("UICorner", n).CornerRadius = UDim.new(0,8)
                local s = Instance.new("UIStroke", n) s.Color = Color3.fromRGB(255, 80, 80)
                TweenService:Create(n, TweenInfo.new(1.2), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
                task.delay(1.2, function() n:Destroy() end)
                return
            end

            return
        end
        
        local isMenuBind = false
        if typeof(Config.Binds.Menu) == "EnumItem" then
            if Config.Binds.Menu.EnumType == Enum.KeyCode and input.KeyCode == Config.Binds.Menu then isMenuBind = true
            elseif Config.Binds.Menu.EnumType == Enum.UserInputType and input.UserInputType == Config.Binds.Menu then isMenuBind = true end
        end
        
        if isMenuBind then
            if screenGui.Enabled then 
                screenGui.Enabled = false 
                UIS.MouseBehavior = Enum.MouseBehavior.Default 
                UIS.MouseIconEnabled = true 
            else 
                screenGui.Enabled = true 
                UIS.MouseBehavior = Enum.MouseBehavior.Default 
                UIS.MouseIconEnabled = true 
            end
        end
        
        local isKillBind = false
        if typeof(Config.Binds.Kill) == "EnumItem" then
            if Config.Binds.Kill.EnumType == Enum.KeyCode and input.KeyCode == Config.Binds.Kill then isKillBind = true
            elseif Config.Binds.Kill.EnumType == Enum.UserInputType and input.UserInputType == Config.Binds.Kill then isKillBind = true end
        end
        if isKillBind then unloadScript() end
    end))
end

